@page "/league"
@rendermode InteractiveServer

<PageTitle>League – Coming Soon</PageTitle>

<div class="soon-shell">
    <div class="soon-card">
        <div class="badge">RRC</div>

        <h1>League table</h1>
        <p class="muted">
            We’re polishing the new league table experience.
            It’ll be available here soon.
        </p>
    </div>
</div>

<style>
    .soon-shell {
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 14px;
        background: radial-gradient(900px 500px at 20% -10%, rgba(255, 204, 0, 0.18), transparent 60%),
                    radial-gradient(700px 400px at 95% 10%, rgba(0, 70, 173, 0.16), transparent 60%),
                    linear-gradient(180deg, #0b2a5b 0%, #071a38 45%, #06152e 100%);
        color: #fff;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    }

    .soon-card {
        width: min(520px, 95vw);
        border-radius: 18px;
        padding: 16px 14px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.14);
        box-shadow: 0 18px 50px rgba(0,0,0,.45);
        backdrop-filter: blur(10px);
    }

    .badge {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: #ffcc00;
        color: #0b2a5b;
        font-weight: 900;
        display: grid;
        place-items: center;
        box-shadow: 0 10px 22px rgba(0,0,0,.35);
        user-select: none;
        margin-bottom: 10px;
    }

    h1 {
        font-size: 18px;
        margin: 0 0 6px 0;
        font-weight: 900;
        letter-spacing: .2px;
    }

    .muted {
        font-size: 13px;
        opacity: .88;
        margin: 0 0 12px 0;
    }

    .bullets {
        margin: 0 0 14px 0;
        padding-left: 18px;
        font-size: 13px;
        opacity: .95;
    }

    .bullets li { margin: 6px 0; }

    .actions {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        padding: 10px 12px;
        font-weight: 800;
        font-size: 13px;
        text-decoration: none;
        flex: 1;
    }

    .primary {
        background: #ffcc00;
        color: #0b2a5b;
        border: none;
        box-shadow: 0 12px 22px rgba(0,0,0,.35);
    }

    .ghost {
        background: transparent;
        color: rgba(255,255,255,.92);
        border: 1px solid rgba(255,255,255,.22);
    }

    .hint {
        margin-top: 12px;
        font-size: 11px;
        opacity: .75;
        text-align: center;
    }
</style>

