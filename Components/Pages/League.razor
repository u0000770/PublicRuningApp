@page "/league"
@rendermode InteractiveServer

@using System.Globalization

@* IMPORTANT: pick ONE of these depending on your actual DTO namespaces *@
@* @using RRCServices.League
@using RRCServices.League.DTO *@
@* If you still have the nested namespace, use this instead: *@
@using RRCServices.League
@using RRCServices.League.DTO


@inject ILeagueTableService LeagueTableService

<PageTitle>League</PageTitle>

<div class="container py-3">
    <h3 class="mb-3">Hypothetical New Rules League Tables</h3>
    <p> Meet or beat = 10, otherwise 6. JR best of 8, DB best of 6, your position is the best possible</p>
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
              @*   <div class="col-12 col-md-4">
                    <label class="form-label">Season start</label>
                    <InputDate @bind-Value="seasonStart" class="form-control" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label">Season end</label>
                    <InputDate @bind-Value="seasonEnd" class="form-control" />
                </div> *@
                <div class="col-12 col-md-4 d-flex gap-2">
                    <button class="btn btn-primary" @onclick="LoadAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span>Loading…</span>
                        }
                        else
                        {
                            <span>Load</span>
                        }
                    </button>

                   @*  <button class="btn btn-outline-secondary" @onclick="Reset" disabled="@isLoading">
                        Reset
                    </button> *@
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @error
                </div>
            }
        </div>
    </div>

    @if (page is null && !isLoading)
    {
        <div class="text-muted">
            Choose dates and click <strong>Load</strong>.
        </div>
    }

    @if (isLoading)
    {
        <div class="alert alert-info">
            Fetching league tables…
        </div>
    }

    @if (page is not null)
    {
        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <strong>JR League</strong>
                        <span class="text-muted small">Jr.Count runner(s)</span>
                    </div>
                    <div class="card-body p-0">
                        @if (page.Jr.Count == 0)
                        {
                            <div class="p-3 text-muted">No JR results for the selected range.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width:70px;">Pos</th>
                                            <th>Runner</th>
                                           @*  <th style="width:110px;">UKAN</th> *@
                                            <th style="width:90px;" class="text-end">Points</th>
                                            <th style="width:120px;" class="text-end">TimeDiff</th>
                                           @*  <th style="width:90px;" class="text-end">Total</th> *@
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in page.Jr)
                                        {
                                            <tr>
                                                <td>@row.Position</td>
                                                <td>@row.RunnerName</td>
                                                @* <td>@(row.Ukan ?? "")</td> *@
                                                <td class="text-end">@row.Points</td>
                                                <td class="text-end">@row.TimeDiffSeconds</td>
                                               @*  <td class="text-end">@FormatTimeDiff(row.TimeDiffSeconds)</td> *@
                                               @*  <td class="text-end">@row.TotalRaces</td> *@
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <strong>DB League</strong>
                        <span class="text-muted small">Db.Count runner(s)</span>
                    </div>
                    <div class="card-body p-0">
                        @if (page.Db.Count == 0)
                        {
                            <div class="p-3 text-muted">No DB results for the selected range.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width:70px;">Pos</th>
                                            <th>Runner</th>
                                           @*  <th style="width:110px;">UKAN</th> *@
                                            <th style="width:90px;" class="text-end">Points</th>
                                            <th style="width:120px;" class="text-end">TimeDiff</th>
                                            @* <th style="width:90px;" class="text-end">Total</th> *@
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in page.Db)
                                        {
                                            <tr>
                                                <td>@row.Position</td>
                                                <td>@row.RunnerName</td>
                                               @*  <td>@(row.Ukan ?? "")</td> *@
                                                <td class="text-end">@row.Points</td>
                                                <td class="text-end">@row.TimeDiffSeconds</td>
                                               @*  <td class="text-end">@FormatTimeDiff(row.TimeDiffSeconds)</td> *@
                                               @*  <td class="text-end">@row.TotalRaces</td> *@
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>


