@page "/mydetails"
@rendermode InteractiveServer

@using Calculator
@using Microsoft.AspNetCore.Components
@using RRCServices
@using RRCServices.Calculator
@using RRCServices.Clock
@using RRCServices.Runner

@* @using RRCServices.Season
@inject ISeasonSettingsService SeasonSettingsService *@

@inject IRunnerService RunnerService
@inject IRaceEventService RaceEventService
@* If you are using these in Calculate() *@
@inject CalculatorService CalculatorService
@inject IClock Clock

<h4>My Time</h4>

@if (_loading)
{
    <p>Loading…</p>
}
else if (_runner is null)
{
    <div class="alert alert-warning">
        Runner not found.
    </div>
}
else
{
    <div class="panel panel-default">
        <div class="panel-body">
            <h2 class="mb-3">@_runner.Ukan @(_runner.Name)</h2>

            <div class="form-group mb-4">
                <label class="form-label">Select Target Race :</label>

                @if (_races.Count == 0)
                {
                    <div class="text-muted">No races available in the next 3 months.</div>
                }
                else
                {
                    <select class="form-control"
                            @bind="_selectedRaceEventId"
                            @bind:after="OnSelectedRaceChanged">
                        @foreach (var race in _races)
                        {
                            <option value="@race.RaceEventId">
                                @race.EventTitle (@race.Date.ToString("d MMM yyyy"))
                            </option>
                        }
                    </select>
                }
            </div>

            @if (TargetTimeText is not null && SelectedRaceEvent is not null)
            {
                <h4 class="mb-3">
                    Target time for selected race is: <strong>@TargetTimeText</strong>
                </h4>

                @if (SummaryText is not null)
                {
                    <p class="mb-2">@SummaryText</p>
                }

                @if (PacePerMileText is not null)
                {
                    <p class="mb-0">
                        You need to be able to run at <strong>@PacePerMileText</strong> per mile pace to achieve this target
                    </p>
                }
            }
            else if (!string.IsNullOrWhiteSpace(_calcMessage))
            {
                <div class="text-muted">@_calcMessage</div>
            }

        </div>
    </div>

    @if (_runner is not null)
    {
        <div class="panel panel-default mt-4">
            <div class="panel-body">
                <h4>Last 3 races (excluding 1 mile)</h4>

                @if (LastThreeNonMileRaces.Count == 0)
                {
                    <p class="text-muted mb-0">
                        No eligible races recorded yet this season (from @_seasonStart.ToString("dd MMM yyyy")).
                        Once you’ve completed at least one race this season, we’ll show your most recent results here.
                    </p>
                    <p>&nbsp</p>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Race</th>
                                <th>Distance</th>
                                <th>Date</th>
                                <th>Recorded Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in LastThreeNonMileRaces)
                            {
                                <tr>
                                    <td>@r.RaceTitle</td>
                                    <td>@FormatRaceDistanceLabel(r.DistanceMeters ?? 0)</td>
                                    <td>@(r.RaceDate?.ToString("d MMM yyyy"))</td>
                                    <td>@FormatHms(r.ActualSeconds ?? 0)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }


    ///
    @if (_runner is not null)
    {
        <div class="panel panel-default">
            <div class="panel-body">
                <h4>Your recorded trophy races:</h4>

                @if (TrophyRaces.Count == 0)
                {
                    <p>We currently have no races recorded to calculate a predicted time</p>
                    <p>&nbsp</p>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Race</th>
                                <th>Distance</th>
                                <th>Date</th>
                                <th>Recorded Time</th>
                                <th>Age Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in TrophyRaces)
                            {
                                <tr>
                                    <td>@r.RaceTitle</td>
                                    <td>@r.DistanceLabel</td>
                                    <td>@r.RaceDate.ToString("dd/MM/yyyy")</td>
                                    <td>@r.RecordedTime</td>
                                    <td>@r.AgeGrade</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }


    ///

}


