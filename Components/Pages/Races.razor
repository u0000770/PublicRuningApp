@page "/races"
@rendermode InteractiveServer

@using RRCServices
@inject IRaceEventService RaceEventService

<PageTitle>JR and DB Races</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="mb-0">JR and DB Races 2026</h3>
</div>

@if (_loading)
{
    <p>Loading…</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_races.Count == 0)
{
    <p class="text-muted">No races found for this period.</p>
}
else
{
    <div class="text-muted mb-2">
       <p>These are our JR and DB Trophy Races - for a definative list refer to the most recent email</p>
    </div>

    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th style="width:110px;">Date</th>
                <th>Event</th>
                <th style="width:110px;">Distance</th>
                <th style="width:200px;">Location</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _races)
            {
                <tr>
                    <td>@r.Date.ToString("dd MMM")</td>
                    <td>@(string.IsNullOrWhiteSpace(r.EventTitle) ? "(untitled)" : r.EventTitle)</td>
                    <td>@(string.IsNullOrWhiteSpace(r.DistanceCode) ? "-" : r.DistanceCode)</td>
                    <td>@(string.IsNullOrWhiteSpace(r.Location) ? "-" : r.Location)</td>
                </tr>
            }
        </tbody>
    </table>
}




